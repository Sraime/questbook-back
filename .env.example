# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Local dev (docker-compose.dev.yml):
DATABASE_URL=postgresql://questbook:questbook@localhost:5432/questbook?schema=public
# On the VPS the host is the compose service name instead of localhost:
# DATABASE_URL=postgresql://questbook:CHANGE_ME@db:5432/questbook?schema=public
POSTGRES_USER=questbook
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=questbook

# --- Tokens ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Google sign-in -------------------------------------------------------
# Comma-separated list of every OAuth client id that may appear in the `aud`
# claim of an ID token: the Web client (used as serverClientId by the app),
# plus the Android and iOS clients.
GOOGLE_CLIENT_IDS=xxxxx.apps.googleusercontent.com

# --- HTTP -----------------------------------------------------------------
# Native apps send no Origin header, so this stays empty unless a web build
# ever talks to the API.
CORS_ORIGINS=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Invitations ----------------------------------------------------------
# Where the links inside invitation emails point. Must be the public origin,
# since it is opened from a mail client and not from inside the container.
PUBLIC_BASE_URL=http://localhost:3000
INVITATION_TTL_DAYS=14

# --- Transactional email (Resend) -----------------------------------------
# Leave RESEND_API_KEY empty to have invitation emails logged instead of sent,
# which is enough to exercise the whole flow locally.
RESEND_API_KEY=
EMAIL_FROM=Questbook <invitations@mail.example.com>

# --- Push notifications (Firebase Cloud Messaging) ------------------------
# From a Firebase service account JSON key. Leave empty to disable push: the
# in-app notification history keeps working either way.
# Keep the \n escapes in the private key exactly as they appear in the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Deployment (docker-compose.yml / Caddyfile) --------------------------
API_DOMAIN=api.example.com
