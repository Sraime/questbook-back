# Caddy obtains and renews the Let's Encrypt certificate on its own, so there
# is no certbot cron job to forget about. API_DOMAIN comes from .env.

{$API_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap console
			fields {
				# Invitation tokens sit in the path; they must not land in the
				# reverse-proxy logs the way a normal URI would.
				request>uri regexp /invitations/[^/?]+ /invitations/[redacted]
				request>headers>Authorization delete
			}
		}
	}

	# Les stores refusent de publier une fiche sans politique de
	# confidentialité, et Play en veut une seconde pour la suppression du
	# compte. Elles vivent ici plutôt que sur un site à part : le certificat
	# est déjà là, et un second domaine serait une échéance de plus à oublier.
	@pages path /confidentialite /suppression-du-compte /style.css
	handle @pages {
		root * /srv/web
		try_files {path}.html {path}
		file_server
	}

	handle {
		reverse_proxy api:3000 {
			health_uri /health
		}
	}
}
