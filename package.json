{
  "name": "questbook-back",
  "version": "0.1.0",
  "private": true,
  "description": "Questbook API — Google sign-in and character/inventory persistence",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "tsx watch src/admin.ts",
    "admin:create": "tsx src/admin/cli/create-admin.ts",
    "admin:totp": "tsx src/admin/cli/totp-code.ts",
    "scenario:import": "tsx src/admin/cli/import-scenario.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:admin": "node dist/admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/websocket": "^11.3.1",
    "@prisma/client": "^6.3.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^10.9.1",
    "prisma": "^6.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "^3.22.5",
      "deepmerge-ts": "^8.0.2"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
