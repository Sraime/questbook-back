// Questbook API data model.
//
// Character ids are generated by the Flutter client (Drift already stores UUID
// v4 primary keys) and reused verbatim here, so a character keeps one identity
// across devices and no client-side id mapping table is ever needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  /// L'identifiant du compte chez son fournisseur de connexion. Un compte en
  /// porte un seul : Apple ne livre l'adresse qu'a la premiere autorisation,
  /// et masquee derriere un relais prive la plupart du temps, donc rien ne
  /// permet de reconnaitre le meme humain d'un fournisseur a l'autre. Les deux
  /// colonnes sont nullables pour cette raison, et l'API refuse de creer un
  /// compte qui n'en renseignerait aucune.
  googleSub String? @unique @map("google_sub")
  appleSub  String? @unique @map("apple_sub")

  email       String   @unique
  displayName String?  @map("display_name")
  pictureUrl  String?  @map("picture_url")
  locale      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Quand ce compte a accepté les conditions d'utilisation. Nul tant qu'il
  /// ne l'a pas fait, y compris pour les comptes anterieurs a leur
  /// publication : c'est cette absence que l'app lit pour barrer l'écran.
  /// Une date plutôt qu'un booléen, pour pouvoir redemander à la révision
  /// suivante sans deviner qui avait vu quoi.
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  /// Quand l'administration a ferme la porte a ce compte, et jusqu'a quand.
  ///
  /// Nul dans `suspendedUntil` veut dire indefiniment : une suspension datee
  /// expire d'elle-meme, lue a chaque controle, sans tache de fond pour la
  /// lever. Le motif est **affiche au joueur**, donc ecrit en francais et
  /// accentue — il le lira sur l'ecran qui lui apprend la nouvelle.
  suspendedAt      DateTime? @map("suspended_at")
  suspendedUntil   DateTime? @map("suspended_until")
  suspensionReason String?   @map("suspension_reason")

  characters    Character[]
  refreshTokens RefreshToken[]

  ownedTables         GameTable[]         @relation("TableOwner")
  memberships         TableMember[]
  sentInvitations     TableInvitation[]   @relation("InvitationSender")
  receivedInvitations TableInvitation[]   @relation("InvitationRecipient")
  attendances         SessionAttendance[]
  clueAccess          SessionClueAccess[]
  deviceTokens        DeviceToken[]
  notifications       Notification[]
  scenarioOwnerships  ScenarioOwnership[]
  shopItemOwnerships  ShopItemOwnership[]
  reportsFiled        Report[]            @relation("ReportAuthor")
  reportsAbout        Report[]            @relation("ReportedUser")
  blocksMade          UserBlock[]         @relation("BlockAuthor")
  blocksAgainst       UserBlock[]         @relation("BlockedUser")

  @@map("users")
}

/// Refresh tokens are stored hashed: a database leak must not hand out live
/// sessions. Rotation revokes the previous row on every successful refresh.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A character is an aggregate root: stats, resources and inventory have no
/// life of their own and are always replaced as a whole on a sync push.
/// `deletedAt` is a tombstone rather than a hard delete so other devices can
/// learn about the deletion during an incremental pull.
model Character {
  id          String    @id
  userId      String    @map("user_id")
  systemId    String    @map("system_id")
  name        String
  occupation  String?
  description String?
  level       Int       @default(1)
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats       CharacterStat[]
  resources   CharacterResource[]
  inventory   InventoryItem[]
  attendances SessionAttendance[]

  @@index([userId, updatedAt])
  @@map("characters")
}

/// Mirrors the Flutter `CharacterStat`: one table backs characteristics,
/// skills and universe-specific attributes, told apart by `kind`.
model CharacterStat {
  id          String  @id
  characterId String  @map("character_id")
  kind        String
  key         String
  label       String
  value       Int
  base        String?
  sortOrder   Int     @default(0) @map("sort_order")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, kind, key])
  @@index([characterId])
  @@map("character_stats")
}

model CharacterResource {
  id          String @id
  characterId String @map("character_id")
  key         String
  label       String
  current     Int
  max         Int
  tone        String @default("neutral")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, key])
  @@index([characterId])
  @@map("character_resources")
}

model InventoryItem {
  id          String  @id
  characterId String  @map("character_id")
  name        String
  qty         Int     @default(1)
  weight      String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("inventory_items")
}

/// A group of players who organise play sessions together. Unlike characters,
/// tables are shared between users, so they are never stored on the client and
/// the server is the only source of truth.
model GameTable {
  id            String   @id @default(uuid())
  title         String
  universeLabel String?  @map("universe_label")
  ownerId       String   @map("owner_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner       User              @relation("TableOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TableMember[]
  invitations TableInvitation[]
  sessions    GameSession[]

  @@index([ownerId])
  @@map("game_tables")
}

/// The table creator is inserted as a `gm` member at creation time, so
/// membership alone answers "may this user see the table", and the role
/// answers "may this user change it".
model TableMember {
  id       String   @id @default(uuid())
  tableId  String   @map("table_id")
  userId   String   @map("user_id")
  role     String
  joinedAt DateTime @default(now()) @map("joined_at")

  table GameTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tableId, userId])
  @@index([userId])
  @@map("table_members")
}

/// Invitations are only ever created for an email that already has an account,
/// so `invitedUserId` is always known and the acceptance link needs no login.
/// The token is stored hashed for the same reason as refresh tokens: whoever
/// holds it can join the table.
model TableInvitation {
  id            String    @id @default(uuid())
  tableId       String    @map("table_id")
  email         String
  /// Null until the address belongs to a Questbook account. The emailed link
  /// then waits for them to sign in rather than granting membership blindly.
  invitedUserId String?   @map("invited_user_id")
  invitedById   String    @map("invited_by_id")
  tokenHash     String    @unique @map("token_hash")
  status        String    @default("pending")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  respondedAt   DateTime? @map("responded_at")

  table       GameTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  invitedUser User?     @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([tableId, email])
  @@index([invitedUserId, status])
  @@map("table_invitations")
}

model GameSession {
  id          String   @id @default(uuid())
  tableId     String   @map("table_id")
  title       String
  description String?
  startsAt    DateTime @map("starts_at")
  location    String
  status      String   @default("scheduled")
  /// Optional catalogue scenario the evening is based on. Dropping the
  /// catalogue row must not erase the session, hence SetNull.
  scenarioId  String?  @map("scenario_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  table       GameTable           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  scenario    Scenario?           @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  attendances SessionAttendance[]
  npcs        SessionNpc[]
  clues       SessionClue[]
  board       SessionBoard?

  @@index([tableId, startsAt])
  @@map("game_sessions")
}

/// Everyone at the table who is not a player: creature, informant, ghost. The
/// game master writes them down before the evening and reads them during it.
///
/// Belongs to the session rather than to the table, and is never exposed to
/// players: what the game master has prepared is precisely what they are not
/// supposed to know. There is no owner column for the same reason — the
/// session already has exactly one game master.
model SessionNpc {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("session_npcs")
}

/// The inverse of a NPC: prepared the same way, but meant to cross the screen.
/// A clue belongs to the session rather than the table, and carries no owner
/// for the same reason as [SessionNpc] — a session has exactly one game master.
///
/// `image` cannot be created yet. It exists so that the clues a scenario will
/// ship with cost a migration today rather than one the day they land.
model SessionClue {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  title           String
  /// `markdown` or `image`, stored as text like the other enumerations here.
  kind            String   @default("markdown")
  contentMarkdown String   @default("") @map("content_markdown") @db.Text
  /// Set for `image` clues only, and read from the scenario's assets.
  assetRef        String?  @map("asset_ref")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  session GameSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  access  SessionClueAccess[]

  @@index([sessionId, createdAt])
  @@map("session_clues")
}

/// Who may read a clue. The absence of a row is the default, and it is the
/// strict one: a clue is nobody's until the game master says otherwise.
///
/// Both cascades matter. Removing a player from the table must not leave them
/// holding a permission, and deleting a clue must not leave rows pointing at
/// nothing.
model SessionClueAccess {
  id        String   @id @default(uuid())
  clueId    String   @map("clue_id")
  userId    String   @map("user_id")
  grantedAt DateTime @default(now()) @map("granted_at")

  clue SessionClue @relation(fields: [clueId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clueId, userId])
  @@index([userId])
  @@map("session_clue_access")
}

/// Backend-owned adventure. Players never create these: they appear in the
/// shop later, and until then a few rows are granted on sign-in.
model Scenario {
  id                       String   @id @default(uuid())
  title                    String
  description              String
  context                  String   @db.Text
  minRecommendedPlayers    Int      @map("min_recommended_players")
  maxRecommendedPlayers    Int      @map("max_recommended_players")
  averageDurationMinutes   Int      @map("average_duration_minutes")
  rundownMarkdown          String   @map("rundown_markdown") @db.Text
  /// Starter catalogue: every account receives ownership on sign-in, so the
  /// list is not empty before the shop exists.
  grantOnSignup            Boolean  @default(false) @map("grant_on_signup")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  annexes     ScenarioAnnex[]
  ownerships  ScenarioOwnership[]
  sessions    GameSession[]
  shopItems   ShopItem[]

  @@map("scenarios")
}

model ScenarioAnnex {
  id               String @id @default(uuid())
  scenarioId       String @map("scenario_id")
  sortOrder        Int    @map("sort_order")
  title            String
  /// `map`, `clue` or `handout` — stored as text like other enumerations here.
  kind             String
  contentMarkdown  String @map("content_markdown") @db.Text

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, sortOrder])
  @@map("scenario_annexes")
}

/// An article on sale. Backend-owned like scenarios: players never create
/// these.
///
/// The server does not describe what a token looks like — that stays with the
/// client, as `board_catalog.dart` already shows — so an asset article carries
/// only the key the app resolves to a drawing. Same for `imageKey`, which
/// names a picture bundled with the app rather than a URL: nothing here hosts
/// files yet.
model ShopItem {
  id          String   @id @default(uuid())
  title       String
  /// `asset`, `scenario` or `pack` — stored as text like other enumerations
  /// here. `pack` has no content model yet and cannot be purchased.
  type        String
  description String   @db.Text
  /// In cents, so no rounding ever happens in the app. `0` is the free
  /// article, and the only price there is until payment exists.
  priceCents  Int      @default(0) @map("price_cents")
  imageKey    String   @map("image_key")
  /// What buying unlocks, one per type. An `asset` article names a token, a
  /// `scenario` article points at the adventure whose ownership it grants.
  assetKey    String?  @map("asset_key")
  scenarioId  String?  @map("scenario_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  scenario   Scenario?           @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  ownerships ShopItemOwnership[]

  @@index([sortOrder])
  @@map("shop_items")
}

/// Who bought what. Mirrors [ScenarioOwnership], which stays the authority on
/// reading an adventure: buying a `scenario` article writes to both, so
/// nothing downstream has to learn about the shop.
model ShopItemOwnership {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  itemId     String   @map("item_id")
  /// `purchase` today. Kept open for a future gift or bundle.
  source     String   @default("purchase")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("shop_item_ownerships")
}

/// Who may see and download a scenario. The shop inserts rows here when a
/// `scenario` article is bought, with `source: 'purchase'`.
model ScenarioOwnership {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  scenarioId String   @map("scenario_id")
  /// `grant` today; `purchase` once the shop lands.
  source     String   @default("grant")
  grantedAt  DateTime @default(now()) @map("granted_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@index([userId])
  @@map("scenario_ownerships")
}

/// The map and the pawns of a session, as the game master last pushed them.
///
/// The board used to live on the device alone. It came up here the day a
/// player had to watch it move: a table is shared, so what everyone looks at
/// cannot be private to one tablet.
///
/// **The game master's device stays the authority.** It writes locally first
/// and pushes when it can — an evening in a cellar with no coverage must keep
/// working, and a board that needed the network to move a pawn would be
/// useless exactly when it is used. This row is therefore a copy that
/// players read, and the last push wins without merging: only one account
/// ever writes it.
///
/// `tokens` is the same opaque JSON the app already stores locally, so
/// adding a field to a pawn needs no migration here. `revision` climbs by one
/// on each push, which lets a listener drop a message that arrives out of
/// order.
model SessionBoard {
  sessionId String   @id @map("session_id")
  tokens    String   @default("[]") @db.Text
  mapId     String?  @map("map_id")
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_boards")
}

/// A missing row means "has not answered yet", which is deliberately distinct
/// from an explicit "no": the GM needs to tell the two apart when deciding
/// whether to go ahead with a session.
/// The character is optional and can be filled in long after the answer: a
/// player confirms first and decides who they are playing later. `SetNull`
/// rather than `Cascade` because losing a character must not erase the fact
/// that its owner had said they would come.
model SessionAttendance {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  userId      String   @map("user_id")
  status      String
  characterId String?  @map("character_id")
  respondedAt DateTime @default(now()) @map("responded_at")

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([characterId])
  @@map("session_attendances")
}

/// One row per device, not per user: a player who installs the app on a phone
/// and a tablet must be reachable on both.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Written inside the same transaction as the change that caused it, which
/// makes the in-app history authoritative. Push delivery is a best-effort side
/// effect layered on top and may legitimately fail without losing anything.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  tableId   String?   @map("table_id")
  sessionId String?   @map("session_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Un contenu signalé comme choquant. Apple exige d'une app à contenu généré
/// qu'on puisse signaler et agir sous 24 h ; le mail part vers le support,
/// mais sans trace en base il n'y aurait rien à rouvrir le lendemain.
///
/// `snapshot` n'est pas une redondance du contenu : son auteur peut le
/// réécrire dans la minute, et l'on examinerait alors une version repentie
/// plutôt que celle qui a choqué. La copie est faite par le serveur, jamais
/// envoyée par le client — un signalement dont on laisserait l'appelant
/// décrire la cible se forge en une requête.
///
/// Les deux relations cascadent : un compte effacé emporte les signalements
/// qu'il a déposés comme ceux qui le visaient. C'est le droit à l'effacement
/// qui l'impose, et le mail parti vers le support garde la mémoire du reste.
model Report {
  id             String   @id @default(uuid())
  reporterId     String   @map("reporter_id")
  reportedUserId String   @map("reported_user_id")
  /// `user`, `table`, `session` ou `investigator` — du texte, comme les
  /// autres énumérations ici, la validation restant côté Zod.
  contentType    String   @map("content_type")
  contentId      String   @map("content_id")
  /// Ce que le contenu disait au moment du signalement, en JSON.
  snapshot       String   @db.Text
  /// Ce que l'auteur du signalement lui reproche, dans ses mots.
  reason         String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  /// `open` puis `resolved`. Sans cette colonne, savoir ce qui restait a
  /// examiner demandait un `psql` sur le VPS — alors que les conditions
  /// d'utilisation annoncent un examen sous vingt-quatre heures.
  status String @default("open")

  /// Ce qui a ete decide : `dismissed`, `warned`, et plus tard `suspended` ou
  /// `deleted`, quand ces gestes existeront.
  resolution     String?   @map("resolution")
  /// Le mot du support, pour le prochain qui relit le dossier.
  resolutionNote String?   @map("resolution_note") @db.Text
  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?   @map("resolved_by_id")

  reporter     User       @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User       @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  /// `SetNull` : un compte d'administration ferme ne doit pas emporter
  /// l'historique des dossiers qu'il a tranches.
  resolvedBy   AdminUser? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Signaler deux fois la même chose n'ajoute rien au dossier et donne un
  /// levier de harcèlement par le nombre.
  @@unique([reporterId, contentType, contentId])
  @@index([createdAt])
  @@index([reportedUserId])
  /// La file du backoffice : les dossiers ouverts, le plus ancien en tete.
  @@index([status, createdAt])
  @@map("reports")
}

/// Quelqu'un dont on ne veut plus. Le blocage est à sens unique et ne se dit
/// pas : le bloqué n'en est pas averti, sans quoi bloquer deviendrait un
/// message de plus à envoyer.
///
/// Il ne suffit pas d'empêcher les invitations à venir : bloquer défait aussi
/// ce qui existe, en séparant les deux comptes des tables qu'ils partagent.
/// C'est ce que le geste promet, et c'est fait dans la transaction du blocage
/// plutôt que vérifié à la lecture — une règle qu'on rejoue à chaque requête
/// finit toujours par être oubliée quelque part.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockAuthor", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// Qui peut entrer dans le backoffice.
///
/// Aucune relation vers `User` : un administrateur n'est pas un joueur avec un
/// drapeau. Les deux populations n'ont ni la meme porte, ni la meme facon de
/// prouver qui elles sont, ni les memes consequences si l'une fuit — les
/// melanger ferait qu'une faille dans la connexion des joueurs deviendrait une
/// faille dans l'administration.
///
/// Pas de Google ici non plus : un joueur passe par un fournisseur tiers parce
/// qu'une table se partage et que chacun doit etre reconnaissable des autres.
/// Un administrateur n'a personne a qui se presenter, et faire dependre
/// l'acces au backoffice d'un service exterieur n'apporterait rien.
model AdminUser {
  id String @id @default(uuid())

  login String @unique

  /// scrypt, avec son sel, dans le format produit par `lib/password.ts`.
  passwordHash String @map("password_hash")

  /// Le secret TOTP en base32, tel que `scripts/create-admin.ts` l'a tire.
  totpSecret String @map("totp_secret")

  /// Le dernier pas de temps TOTP consomme. Un code vaut trente secondes, et
  /// sans cette borne il serait rejouable pendant tout ce temps par qui
  /// regarde par-dessus l'epaule.
  lastTotpStep BigInt? @map("last_totp_step")

  /// Echecs consecutifs, remis a zero par une reussite. Au-dela du plafond,
  /// `lockedUntil` ferme la porte pour un temps : un mot de passe se devine
  /// par la repetition, et c'est la repetition qu'on coupe.
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until")

  lastLoginAt DateTime? @map("last_login_at")

  /// Retire l'acces sans effacer les lignes d'audit qui nomment ce compte.
  disabledAt DateTime? @map("disabled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions        AdminSession[]
  auditLog        AdminAuditEntry[]
  resolvedReports Report[]

  @@map("admin_users")
}

/// Une session ouverte dans le backoffice.
///
/// Un jeton opaque hache, sur le modele des `refresh_tokens` et des jetons
/// d'invitation, plutot qu'un JWT autoporteur : un backoffice doit pouvoir
/// etre deconnecte a distance, ce qu'un jeton que le serveur ne relit jamais
/// ne permet pas.
model AdminSession {
  id      String @id @default(uuid())
  adminId String @map("admin_id")

  tokenHash String @unique @map("token_hash")

  /// Glissante : chaque requete la repousse, si bien qu'un poste laisse seul
  /// se referme, et qu'une soiree de moderation ne se fait pas interrompre.
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Ce que l'administration a fait, et quand.
///
/// C'est le seul composant du produit capable de lire les donnees de tout le
/// monde et d'effacer le compte de quelqu'un : la trace n'est pas une option.
/// Chaque carte suivante ecrit sa ligne **dans la transaction** de l'action
/// qu'elle journalise, comme le font deja les notifications — un journal ecrit
/// apres coup manque precisement les cas ou il servirait.
///
/// Rien n'efface ces lignes, et aucune route ne les modifie.
model AdminAuditEntry {
  id String @id @default(uuid())

  /// Nul quand la tentative n'a identifie personne : un echec de connexion sur
  /// un login inconnu merite sa ligne autant qu'une reussite.
  adminId String? @map("admin_id")

  /// `login.success`, `login.failure`, `logout`… Du texte, comme les autres
  /// enumerations ici.
  action String

  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  /// Le detail utile a la relecture, en JSON. Jamais de secret : ni mot de
  /// passe, ni code, ni jeton de session.
  details String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@map("admin_audit_log")
}
